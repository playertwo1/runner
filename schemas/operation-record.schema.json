{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ideias-standard.local/schemas/operation-record.schema.json",
  "title": "Ideias Standard Idempotent Operation Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "source", "actor", "report_path", "report_sha256", "result"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "operation_id": {"type": "string", "pattern": "^op-[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "machine_state", "actor", "audit_round", "builder_head_sha", "audit_target_sha", "last_audited_sha"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^run-[0-9a-f]{64}$"},
        "machine_state": {"enum": ["READY_FOR_BUILD", "READY_FOR_AUDIT", "AUDITING", "FIX_REQUIRED", "WAITING_PRODUCT_AUTHORITY", "GATE_APPROVED", "BLOCKED"]},
        "actor": {"enum": ["BUILDER", "AUDITOR"]},
        "audit_round": {"type": "integer", "minimum": 0},
        "builder_head_sha": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]},
        "audit_target_sha": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]},
        "last_audited_sha": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]}
      }
    },
    "actor": {"enum": ["BUILDER", "AUDITOR"]},
    "report_path": {"type": "string", "minLength": 1},
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result": {"type": "object"}
  }
}
