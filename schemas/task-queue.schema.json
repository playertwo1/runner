{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ideias-standard.local/schemas/task-queue.schema.json",
  "title": "Ideias Standard Task Queue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "invocation_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "queue_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "phase": {
      "type": "string",
      "enum": ["S0", "O0", "S1", "S2", "S3", "S4", "S5", "S6"]
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task_item"
      }
    }
  },
  "$defs": {
    "task_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "goal",
        "scope",
        "acceptance_criteria",
        "phase"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "phase": {
          "type": "string",
          "enum": ["S0", "O0", "S1", "S2", "S3", "S4", "S5", "S6"]
        },
        "builder_task": {
          "type": "string"
        },
        "auditor_criteria": {
          "type": "string"
        },
        "builder_command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auditor_command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "human_gate_required": {
          "type": "boolean"
        }
      }
    }
  }
}
